{
  "run_name": "mixtral_8x7b_decode",
  "model": {
    "name_or_path": "mistralai/Mixtral-8x7B-v0.1",
    "dtype": "bfloat16",
    "device_map": "auto",
    "attn_implementation": "sdpa",
    "max_memory": {"0": "80GiB", "1": "80GiB", "cpu": "150GiB"}
  },
  "data": {
    "dataset": "Salesforce/wikitext",
    "subset": "wikitext-2-raw-v1",
    "split": "test",
    "seq_len": 256,
    "max_sequences": 8,
    "batch_size": 1
  },
  "profiler": {
    "record_trace": true,
    "trace_flush_rows": 2000000,
    "cross_check_router": true,
    "max_new_tokens": 256
  },
  "classify": {
    "method": "top_fraction",
    "value": 0.25,
    "per_layer": true
  }
}
